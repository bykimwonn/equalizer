{
  "name": "bt-ai-equalizer",
  "productName": "BT AI Equalizer",
  "version": "1.0.0",
  "description": "AI real-time PC audio enhancer for Windows — local DSP engine with Groq/Gemini-assisted sound profiling.",
  "type": "module",
  "main": "electron/main.js",
  "author": "BT Audio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "lint": "node scripts/lint.js",
    "build:native": "node scripts/build-native.js",
    "pack:win": "electron-builder --win nsis",
    "pack:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "groq-sdk": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.bt.ai-equalizer",
    "productName": "BT AI Equalizer",
    "copyright": "Copyright © 2026 BT Audio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "engine/**/*",
      "dist/**/*",
      "native/**/build/Release/*.node",
      "native/apo/bin/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BT-AI-Equalizer-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "native/apo/bin",
        "to": "apo",
        "filter": ["**/*"]
      }
    ]
  }
}
